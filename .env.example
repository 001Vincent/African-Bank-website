# MongoDB connection string (MongoDB Atlas or Railway MongoDB plugin)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/unionsAfricaBank

# Secret used to sign JWT auth tokens - use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret

# Optional: anyone who enters this code on the register page becomes an admin
ADMIN_SIGNUP_CODE=letmein-admin-2026

# Optional: SMTP settings for transaction receipt emails (deposits & withdrawals).
# If left unset, the app skips sending and just logs it — deposits/withdrawals still work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Unions Africa Bank <no-reply@unionsafricabank.com>
