# MongoDB connection string (MongoDB Atlas or Railway MongoDB plugin)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/unionsAfricaBank

# Secret used to sign JWT auth tokens - use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret

# Optional: anyone who enters this code on the register page becomes an admin
ADMIN_SIGNUP_CODE=letmein-admin-2026
